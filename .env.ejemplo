# Claves de la página. NUNCA se escriben aquí a mano ni se pegan en el chat: corre  npm run claves
# Este archivo es solo la lista. Las claves de verdad quedan en .env (que no se sube a GitHub).

# Google Maps Platform: Maps JavaScript API + Places API (New) + Solar API. Restringida a tu dominio. Ver docs/GOOGLE-MAPS.md
GOOGLE_MAPS_API_KEY=

# Opcional. Web3Forms (web3forms.com). Sin esta, los formularios usan FormSubmit con leads.correo de compania/sitio.json
WEB3FORMS_KEY=
